        // i + 2 < n
        mov.u32 %tmp, %i;
        add.u32 %tmp, %tmp, 2;
        setp.lt.u32 %p, %tmp, %n;
        // j + 0 < m
        mov.u32 %tmp, %j;
        setp.lt.u32 %p2, %tmp, %m;
        and.pred %p2, %p2, %p;
@%p2    st.global.f32 [%tmpa], %cr8;            // c[i + 2][j + 0] = cr8
        // j + 1 < m
        mov.u32 %tmp, %j;
        add.u32 %tmp, %tmp, 1;
        setp.lt.u32 %p2, %tmp, %m;
        and.pred %p2, %p2, %p;
@%p2    st.global.f32 [%tmpa + (1 << 2)], %cr9; // c[i + 2][j + 1] = cr9
        // j + 2 < m
        mov.u32 %tmp, %j;
        add.u32 %tmp, %tmp, 2;
        setp.lt.u32 %p2, %tmp, %m;
        and.pred %p2, %p2, %p;
@%p2    st.global.f32 [%tmpa + (2 << 2)], %cr10;// c[i + 2][j + 2] = cr10
        // j + 3 < m
        mov.u32 %tmp, %j;
        add.u32 %tmp, %tmp, 2;
        setp.lt.u32 %p2, %tmp, %m;
        and.pred %p2, %p2, %p;
@%p2    st.global.f32 [%tmpa + (3 << 2)], %cr11;// c[i + 2][j + 3] = cr11
        cvt.u64.u32 %tmpa2, %m;
        shl.b64 %tmpa2, %tmpa2, 2;
